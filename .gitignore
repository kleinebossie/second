# Git keep files must be tracked
!.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python testing and linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Node / TypeScript / Vite
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
extension/dist/
dist/
dist-ext/
spikes/browser-runtime/public/

# Local environment variables and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Model weights and checkpoints
*.safetensors
*.gguf
*.onnx
*.bin
*.pt
*.pth
checkpoints/
models/
wandb/

# Downloaded tools and engine binaries
stockfish_bin/
*.tar.gz

# Local data caches and large temporary files
data/cache/
data/raw/
data/processed/
.cache/
eval/rating_space/chesscom_pairs.jsonl
eval/rating_space/votes.jsonl
eval/results/judge_cache.jsonl

# Operating system files
.DS_Store
Thumbs.db

# Editor and IDE directories
.idea/
.vscode/
*.swp
*~
