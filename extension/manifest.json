{
  "manifest_version": 3,
  "name": "Second - Chess Assistant",
  "version": "0.1.0",
  "description": "Explains chess positions and moves clearly using local in-browser language models.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Second Chess Assistant"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
